{
  "manifest_version": 3,
  "name": "视频分析 · DeepSeek",
  "short_name": "视频分析",
  "description": "把浏览器中正在播放的视频一键交给本地「视频分析 · DeepSeek」服务，生成语音转写、内容总结与问答。",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "视频分析 · DeepSeek",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
